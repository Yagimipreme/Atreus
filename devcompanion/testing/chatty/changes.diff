# %% tests-only
# expect: adds tests only (first page, partial last page, `page_count` rounding up, page 0 rejected); no production code changes
diff --git a/tests/test_paging.py b/tests/test_paging.py
new file mode 100644
index 0000000..d91d463
--- /dev/null
+++ b/tests/test_paging.py
@@ -0,0 +1,20 @@
+import pytest
+
+from shop.paging import page, page_count
+
+
+def test_first_page_starts_at_first_item():
+    assert page(list(range(50)), 1, size=20) == list(range(20))
+
+
+def test_last_page_is_partial():
+    assert page(list(range(50)), 3, size=20) == list(range(40, 50))
+
+
+def test_page_count_rounds_up():
+    assert page_count(list(range(41)), size=20) == 3
+
+
+def test_page_zero_is_rejected():
+    with pytest.raises(ValueError):
+        page([], 0)

