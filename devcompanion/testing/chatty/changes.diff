# %% page-off-by-one
# expect: fixes `page` returning the second page for page 1 (it skipped the first `size` items); page numbers below 1 now raise ValueError
diff --git a/src/shop/paging.py b/src/shop/paging.py
index bb0a950..5581839 100644
--- a/src/shop/paging.py
+++ b/src/shop/paging.py
@@ -1,6 +1,8 @@
 def page(items, number, size=20):
     """Return page `number` (1-based) of `items`."""
-    start = number * size
+    if number < 1:
+        raise ValueError(f"page numbers start at 1, got {number}")
+    start = (number - 1) * size
     return items[start:start + size]
 
 

