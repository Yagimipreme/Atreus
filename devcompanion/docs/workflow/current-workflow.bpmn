    </bpmn:exclusiveGateway>
    <bpmn:task id="b_present" name="Write board.md + quickfix.txt; publish findings.jsonl + engine.json atomically; record timings">
      <bpmn:incoming>bundle_flow_15</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="b_end" name="Results ready for voluntary reading">
      <bpmn:incoming>bundle_flow_16</bpmn:incoming>
    </bpmn:endEvent>
