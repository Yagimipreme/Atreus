<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_devcompanion" targetNamespace="urn:devcompanion:workflow" exporter="devcompanion workflow documentation" exporterVersion="1">
  <bpmn:process id="intake" name="BPMN 2.0 · Event intake" isExecutable="false">
    <bpmn:documentation>Scope: accepted engine Event under contract v2, not all contract messages. The editor sends canonical buffer text; the engine recomputes its hash rather than trusting the declared one, reports a mismatch, and uses the bytes that arrived. Origin decides everything downstream: editor content exists only in a buffer, disk content is what shelling-out tools can see. A save that changes no bytes still passes through scheduling, because the same content becoming visible to pytest and rg is news. Scheduling submission is asynchronous in watch; it is not a BPMN sequence flow into the worker process.</bpmn:documentation>
    <bpmn:startEvent id="i_start" name="Event received">
      <bpmn:outgoing>intake_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="i_session" name="Session event? goal / dismiss / request / lsp_result / session_end">
      <bpmn:incoming>intake_flow_0</bpmn:incoming>
      <bpmn:outgoing>intake_flow_1</bpmn:outgoing>
      <bpmn:outgoing>intake_flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="i_session_do" name="Record it; session_end drops that editor's overlays and requeues those paths">
      <bpmn:incoming>intake_flow_1</bpmn:incoming>
      <bpmn:outgoing>intake_flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="i_session_end" name="Published; no file analysis">
      <bpmn:incoming>intake_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="i_light" name="Cursor or diagnostics?">
      <bpmn:incoming>intake_flow_3</bpmn:incoming>
      <bpmn:outgoing>intake_flow_4</bpmn:outgoing>
      <bpmn:outgoing>intake_flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="i_light_do" name="Append event; store diagnostics for republication">
      <bpmn:incoming>intake_flow_4</bpmn:incoming>
      <bpmn:outgoing>intake_flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="i_light_end" name="No investigation">
      <bpmn:incoming>intake_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="i_content" name="Resolve content: editor text (hash verified) → recorded SHA → disk. Origin is editor when the buffer is dirty">
      <bpmn:incoming>intake_flow_6</bpmn:incoming>
      <bpmn:outgoing>intake_flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_missing" name="Content missing?">
      <bpmn:incoming>intake_flow_7</bpmn:incoming>
      <bpmn:outgoing>intake_flow_8</bpmn:outgoing>
      <bpmn:outgoing>intake_flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="i_delete" name="Log file_deleted; forget any overlay">
      <bpmn:incoming>intake_flow_8</bpmn:incoming>
      <bpmn:outgoing>intake_flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="i_delete_end" name="Deletion handling stops">
      <bpmn:incoming>intake_flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="i_snap" name="Seed Git HEAD baseline on first live sight; snapshot with origin; record overlay or disk revision; log without text">
      <bpmn:incoming>intake_flow_10</bpmn:incoming>
      <bpmn:outgoing>intake_flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_same" name="Same bytes AND same origin?">
      <bpmn:incoming>intake_flow_11</bpmn:incoming>
      <bpmn:outgoing>intake_flow_12</bpmn:outgoing>
      <bpmn:outgoing>intake_flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="i_same_end" name="No work">
      <bpmn:incoming>intake_flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="i_queue" name="Submit path, SHA and origin to scheduler">
      <bpmn:incoming>intake_flow_13</bpmn:incoming>
      <bpmn:outgoing>intake_flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i_changed" name="Bytes actually changed?">
      <bpmn:incoming>intake_flow_14</bpmn:incoming>
      <bpmn:outgoing>intake_flow_15</bpmn:outgoing>
      <bpmn:outgoing>intake_flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="i_saved_end" name="Save of already-analysed bytes; tools rerun, nothing invalidated">
      <bpmn:incoming>intake_flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="i_stale" name="Mark dependent claims stale and requeue their defining files">
      <bpmn:incoming>intake_flow_16</bpmn:incoming>
      <bpmn:outgoing>intake_flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="i_new" name="Requeue any claim whose callee this file now names but never depended on">
      <bpmn:incoming>intake_flow_17</bpmn:incoming>
      <bpmn:outgoing>intake_flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="i_end" name="Event handled; worker runs separately">
      <bpmn:incoming>intake_flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="intake_flow_0" sourceRef="i_start" targetRef="i_session" name="" />
    <bpmn:sequenceFlow id="intake_flow_1" sourceRef="i_session" targetRef="i_session_do" name="yes" />
    <bpmn:sequenceFlow id="intake_flow_2" sourceRef="i_session_do" targetRef="i_session_end" name="" />
    <bpmn:sequenceFlow id="intake_flow_3" sourceRef="i_session" targetRef="i_light" name="no" />
    <bpmn:sequenceFlow id="intake_flow_4" sourceRef="i_light" targetRef="i_light_do" name="yes" />
    <bpmn:sequenceFlow id="intake_flow_5" sourceRef="i_light_do" targetRef="i_light_end" name="" />
    <bpmn:sequenceFlow id="intake_flow_6" sourceRef="i_light" targetRef="i_content" name="no" />
    <bpmn:sequenceFlow id="intake_flow_7" sourceRef="i_content" targetRef="i_missing" name="" />
    <bpmn:sequenceFlow id="intake_flow_8" sourceRef="i_missing" targetRef="i_delete" name="yes" />
    <bpmn:sequenceFlow id="intake_flow_9" sourceRef="i_delete" targetRef="i_delete_end" name="" />
    <bpmn:sequenceFlow id="intake_flow_10" sourceRef="i_missing" targetRef="i_snap" name="no" />
    <bpmn:sequenceFlow id="intake_flow_11" sourceRef="i_snap" targetRef="i_same" name="" />
    <bpmn:sequenceFlow id="intake_flow_12" sourceRef="i_same" targetRef="i_same_end" name="yes" />
    <bpmn:sequenceFlow id="intake_flow_13" sourceRef="i_same" targetRef="i_queue" name="no" />
    <bpmn:sequenceFlow id="intake_flow_14" sourceRef="i_queue" targetRef="i_changed" name="" />
    <bpmn:sequenceFlow id="intake_flow_15" sourceRef="i_changed" targetRef="i_saved_end" name="no" />
    <bpmn:sequenceFlow id="intake_flow_16" sourceRef="i_changed" targetRef="i_stale" name="yes" />
    <bpmn:sequenceFlow id="intake_flow_17" sourceRef="i_stale" targetRef="i_new" name="" />
    <bpmn:sequenceFlow id="intake_flow_18" sourceRef="i_new" targetRef="i_end" name="" />
  </bpmn:process>
