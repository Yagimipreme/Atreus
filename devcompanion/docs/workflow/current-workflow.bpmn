  <bpmn:process id="bundle" name="BPMN 2.0 · Scheduled investigation bundle" isExecutable="false">
    <bpmn:documentation>One scheduler worker. The 400 ms debounce is reset per submitted path; ingest/replay drain immediately. The baseline choice is the difference between useful and noisy: an unsaved buffer is compared against the last save, so an edit typed across several debounce windows reads as one change. Tests run after all tasks, once per bundle, and only for content that is on disk — pytest imports the working tree and cannot see a buffer. Test results include passed, failed, none, unavailable and timeout. No parallel gateway: tests and suggestions execute synchronously in this worker.</bpmn:documentation>
    <bpmn:startEvent id="b_start" name="Path bundle pending">
      <bpmn:outgoing>bundle_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="b_wait" name="Wait until debounce due; newer submission replaces pending bundle">
      <bpmn:incoming>bundle_flow_0</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="b_base" name="Content came from the editor?">
      <bpmn:incoming>bundle_flow_1</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_2</bpmn:outgoing>
      <bpmn:outgoing>bundle_flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="b_base_e" name="Baseline is the last saved content: one edit, not a stream of drafts">
      <bpmn:incoming>bundle_flow_2</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b_base_d" name="Baseline is the previous saved content">
      <bpmn:incoming>bundle_flow_3</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b_detect" name="Record superseded bundles; compare baseline and current">
      <bpmn:incoming>bundle_flow_4</bpmn:incoming>
      <bpmn:incoming>bundle_flow_5</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b_tasks" name="For each detected task, run investigation process below; store evidence">
      <bpmn:incoming>bundle_flow_6</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="b_tests" name="Changed/removed names AND tests enabled AND content is on disk?">
      <bpmn:incoming>bundle_flow_7</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_8</bpmn:outgoing>
      <bpmn:outgoing>bundle_flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="b_no" name="No test run; unsaved content is not something pytest can import">
      <bpmn:incoming>bundle_flow_8</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="b_replay" name="Replay mode?">
      <bpmn:incoming>bundle_flow_9</bpmn:incoming>
      <bpmn:outgoing>bundle_flow_11</bpmn:outgoing>
      <bpmn:outgoing>bundle_flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="b_skip" name="Record skipped: replay never executes tests">
