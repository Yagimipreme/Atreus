# Build and tooling state. The lockfile IS tracked: it is the record of what was tested.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Engine state. Every workspace the companion observes grows one of these, including this one
# when it is pointed at itself; it is derived from the event log and never worth committing.
.companion/

# Local scratch
nvim.log
